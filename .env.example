# Neon Postgres for the live /play leaderboard (ripple database).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/ripple?sslmode=require

# Shopify store domain (no https://). Defaults to usmhdz-1h.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=usmhdz-1h.myshopify.com
SHOPIFY_STORE_DOMAIN=usmhdz-1h.myshopify.com

# Optional later: Storefront API token if you want checkout without leaving this domain.
# Cart permalink checkout works without this.
VITE_SHOPIFY_STOREFRONT_TOKEN=
