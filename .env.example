# Shopify Storefront API — fill these after the shop exists, then rebuild.
# Admin: Settings → Apps and sales channels → Develop apps → Storefront API
# Create collections with handles: ripple-of-history  and  ww2hub
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional public shop URL if you want a "Visit Shopify" link before the API is wired
VITE_SHOPIFY_STORE_URL=
